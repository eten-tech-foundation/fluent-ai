# syntax=docker/dockerfile:1

FROM python:3.14-slim

# Install dumb-init for proper signal handling and curl for healthchecks
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends dumb-init curl && \
    rm -rf /var/lib/apt/lists/*

# Prevent Python from writing bytecode and enable unbuffered output
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Create non-root user with limited permissions
RUN groupadd -g 1001 python && \
    useradd -u 1001 -g python -s /bin/false python

WORKDIR /app

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install all dependencies including dev
RUN uv sync --frozen --no-install-project

# Copy entrypoint and Alembic config (source code is bind-mounted for hot-reload).
# alembic.ini is also bind-mounted by compose/podman, so this COPY is a fallback
# that lets the image work standalone if someone runs it without a bind mount.
COPY --chown=python:python docker-entrypoint.sh alembic.ini ./

# Create log directory for file-based logging (LOG_OUTPUT=file|both)
RUN mkdir -p /app/logs

# Create log directory for file-based logging (LOG_OUTPUT=file|both)
RUN mkdir -p /app/logs

# Set ownership for app directory
RUN chown -R python:python /app

# Switch to non-root user
USER python

EXPOSE 8200

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8200/health || exit 1

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "docker-entrypoint.sh"]
