# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Fluent AI API
APP_VERSION=0.1.0
PORT=8200

# ── Database ─────────────────────────────────────────────────────────────────
# Role passwords below are dev-only defaults — override in any shared/deployed env.
# Runtime role (ai schema only):
DATABASE_URL=postgresql+asyncpg://ai_user:password@localhost:5432/fluent
# Migration role (DDL on ai):
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://ai_migrator:password@localhost:5432/fluent
# Superuser used only by the bootstrap script:
BOOTSTRAP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fluent

# Optional: SHA-256 hash of a production admin API key seeded on startup.
# Never commit the raw key — only the hash. Leave unset in development.
# ADMIN_API_KEY_HASH=

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-not-for-production

# ── Development API key ───────────────────────────────────────────────────────
# Seeded automatically on first DB start. Use in X-API-Key header locally.
# Never use this key outside of local development.
DEV_API_KEY=fai_dev_admin

# ── Environment ───────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# true for stack traces in dev (never in production)
SHOW_STACK_TRACES=false
# stdout | file | both
LOG_OUTPUT=stdout

# ── External AI Services ─────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash-lite

# ── Internal API Integration ─────────────────────────────────────────────────
# Base URL of the fluent-api service (no trailing slash)
# - Ecosystem mode (via fluent-platform): http://fluent-api:9999
# - Standalone fluent-ai against standalone fluent-api: http://localhost:9999
API_BASE_URL=http://fluent-api:9999
# Key used to authenticate outgoing requests to fluent-api
API_SERVICE_KEY=dev-inbound-key-replace-me


# ── Source TTS: Cloudflare R2 artifact storage ───────────────────────────────
# ALL OPTIONAL. Leave the credentials blank and the service still boots — only
# the TTS endpoints refuse to serve. Nothing else in fluent-ai reads these.
#
# There is deliberately NO endpoint variable: the S3 endpoint is DERIVED as
#   https://{R2_ACCOUNT_ID}.{eu.|}r2.cloudflarestorage.com
# so the jurisdiction cannot drift out of sync with the host. The team's
# buckets are EU-jurisdiction, so leave R2_JURISDICTION=eu — an unpinned host
# fails HeadBucket against buckets that do exist.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# eu (GDPR, data stays in the EU — the team's default) | default (unpinned)
R2_JURISDICTION=eu
# Bucket holding sidecars, audio and receipts. Dev bucket: fluent-tts-dev
R2_TTS_BUCKET=
# Key prefix inside the bucket; requests/, audio/ and receipts/ live under it.
# Normalized on load, so 'tts', '/tts' and 'tts/' are all read as 'tts/'.
TTS_R2_PREFIX=tts/

# Public base URL of the R2 custom domain that serves compressed audio; it is
# the 302 target for get-audio. Dev: https://dev.tts.fluent.bible
# When blank, audio redirects fail cleanly rather than emitting a broken URL.
TTS_PUBLIC_AUDIO_BASE_URL=

# HMAC key for artifact identity. Scripture text is PUBLIC, so a bare content
# hash would be computable by anyone; this secret is what makes knowing an
# artifact hash a capability. Use a long random value, keep it stable (changing
# it renames every future artifact), and never commit the real one.
TTS_HASH_SECRET=

# ── Source TTS: synthesis recipe ─────────────────────────────────────────────
# These participate in artifact identity: changing one changes every future
# hash, so existing artifacts are simply never referenced again (no rewrite,
# no eviction — old objects are cold, not wrong).
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
# ogg-opus | mp3 — resolved BEFORE hashing when a request omits `format`, so
# "unspecified" never exists internally and omitting clients all dedup together.
TTS_DEFAULT_FORMAT=ogg-opus
# Tripwire, not a product limit: legitimate input is verse-sized, and this
# catches accidental chapter/book submission or abuse.
#
# THIS SERVICE IS THE ONLY PLACE THE LIMIT LIVES. fluent-api is a passive proxy
# and validates shape only — it deliberately has no copy of this number, so
# there is no second value to drift out of step with this one. An oversized body
# therefore travels one internal hop before rejection, which costs nothing:
# rejection happens before any provider call, so nothing is billed.
TTS_MAX_TEXT_LENGTH=20000

# ── Source TTS: the generation heap's RAM budget ─────────────────────────────
# One system, not five knobs. The admission gate holds
# ⌊TTS_MAX_BUFFERED_BYTES / TTS_MAX_CLIP_BYTES⌋ slots, each slot is a WORST-CASE
# byte reservation, and a request that cannot get one waits
# TTS_ADMISSION_WAIT_SECONDS and is then refused with 503 + Retry-After. Change
# the budget or the ceiling and the slot count moves with it.
#
# 256 MiB ⇒ 30 worst-case slots. Container memory wants roughly 1.5x headroom
# over this (ffmpeg subprocess, interpreter, fragmentation), so ~384 MiB on top
# of the service's baseline. This is a byte counter the service keeps itself —
# never RSS, which over-reports live data after a spike and would throttle the
# service permanently.
TTS_MAX_BUFFERED_BYTES=268435456
# Per-clip ceiling: one slot's reservation, and the per-append tripwire that
# kills a generation growing past it. Derived from the product, not the
# provider: the largest legitimate clip is the longest verse (~550 characters;
# the project corpus tops out at 436 and its median is 110), speech runs about
# 4,000 bytes of PCM per character, and the default is 4x that = 8.8 MB, i.e.
# ~183 s of audio. Gemini's own output cap (30 MiB, 655 s) sat 3.4x higher and
# made a poor tripwire: a provider had to stream eleven minutes of audio for a
# single verse before anything stopped it.
TTS_MAX_CLIP_BYTES=8800000
# A short queue absorbs bursts; a long one just holds clients on a connection
# that is going to fail anyway.
TTS_ADMISSION_WAIT_SECONDS=3.0
# Retry-After value on an admission refusal. Slots are held for seconds each
# (synthesis runs ~1.3x realtime on a verse), so this is a realistic wait.
TTS_RETRY_AFTER_SECONDS=5
# Hard ceiling on one generation task, so a provider that connects and then
# goes silent cannot pin an admission slot forever. Above the 655 s output cap,
# so it can only fire on a stall.
TTS_GENERATION_MAX_SECONDS=900.0
# Reader max-lifetime: bounds how long one slow client can pin a finished
# buffer and the slot behind it. Also above 655 s, so a listener consuming a
# maximum-length clip at realtime is never cut off.
TTS_READER_MAX_SECONDS=900.0
